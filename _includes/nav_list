{% assign navigation = site.data.navigation[include.nav] %}

<nav id="site-nav" class="greedy-nav">
  {% if site.title %}
    <a class="site-title" href="{{ '/' | relative_url }}">{{ site.title }}</a>
  {% endif %}
  <ul class="visible-links">
    {% for link in navigation %}
      <li class="masthead__menu-item dropdown">
        <a href="{{ link.url | relative_url }}" {% if link.description %}title="{{ link.description }}"{% endif %}>
          {{ link.title }}
          {% if link.children %} <i class="fas fa-caret-down" aria-hidden="true"></i>{% endif %}
        </a>
        {% if link.children %}
          <ul class="dropdown-menu">
            {% for child in link.children %}
              <li>
                <a href="{{ child.url | relative_url }}">{{ child.title }}</a>
              </li>
            {% endfor %}
          </ul>
        {% endif %}
      </li>
    {% endfor %}
  </ul>
  <button class="greedy-nav__toggle hidden" type="button">
    <span class="visually-hidden">{{ site.data.ui-text[site.locale].menu_label | default: "Toggle menu" }}</span>
    <div class="navicon"></div>
  </button>
  <ul class="hidden-links hidden"></ul>
</nav>